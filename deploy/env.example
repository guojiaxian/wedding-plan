# 备婚计划 · 生产环境变量（复制为 .env 使用；本文件不含密钥，且 .env 不入 git）
# 适用：阿里云生产机 /root/applications/wedding-plan
# 注意：开发机端口保持 19002（见项目根目录 .env），本文件只用于生产。

# 时区（不修改系统时区）
TZ=Asia/Shanghai

# 生产服务端口：80（对外直接访问 http://<服务器IP>/）
PORT=80

# 监听地址：0.0.0.0 = 局域网/公网（公网访问还需阿里云安全组放行 80/TCP）
HOST=0.0.0.0

# SQLite 数据库路径（默认 <项目>/server/data/wedding.db，一般无需修改）
# DB_PATH=/root/applications/wedding-plan/server/data/wedding.db
