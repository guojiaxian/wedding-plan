# 备婚计划 · 环境变量配置（复制为 .env 使用；该文件不含密钥，且不入 git）
# 时区（文档 6.4 要求，不修改系统时区）
TZ=Asia/Shanghai

# 服务端口（文档 3.3：新服务专用端口，不得占用 22/3000）
PORT=19002

# 监听地址：0.0.0.0 = 局域网/公网（公网访问还需阿里云安全组放行，联系负责人）
HOST=0.0.0.0

# SQLite 数据库路径（默认 <项目>/server/data/wedding.db；一般无需修改）
# DB_PATH=/root/wedding-plan/server/data/wedding.db
