# 备婚计划 · 生产环境变量（复制为 .env 使用；本文件不含密钥，且 .env 不入 git）
# 适用：阿里云生产机 /root/applications/wedding-plan
# 架构：Caddy 对外监听 80/8443，反代到本机 127.0.0.1:19002
# 注意：开发机端口保持 19002、监听 0.0.0.0（见项目根目录 .env），本文件只用于生产。

# 时区（不修改系统时区）
TZ=Asia/Shanghai

# 应用内部端口：只给本机 Caddy 反代使用，不直接暴露公网
PORT=19002

# 监听地址：127.0.0.1 = 仅本机可访问，公网 80 由 Caddy 提供
HOST=127.0.0.1

# SQLite 数据库路径（默认 <项目>/server/data/wedding.db，一般无需修改）
# DB_PATH=/root/applications/wedding-plan/server/data/wedding.db
